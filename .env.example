# Secrets for vs_baselines. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and never committed.

# API key for the VisualProbe open-ended LLM judge (eval/adapters/visualprobe_hard.py).
# Uses an OpenAI-compatible endpoint (DashScope by default). Either name works.
QWEN_API_KEY=
# DASHSCOPE_API_KEY=

# Optional judge overrides (defaults: qwen-max via DashScope):
# VS_JUDGE_MODEL=qwen-max
# VS_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set VS_JUDGE=0 to force the offline rule-based fallback (no API needed).
